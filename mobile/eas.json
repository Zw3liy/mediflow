{
  "cli": {
    "version": ">=18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "patient-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_WORKSPACE": "patient"
      }
    },
    "doctor-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_WORKSPACE": "doctor"
      }
    },
    "reception-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_WORKSPACE": "reception"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
