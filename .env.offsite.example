# Keep .env.offsite private (chmod 600), never commit it.
RESTIC_REPOSITORY=s3:https://your-storage-endpoint/your-private-bucket
RESTIC_PASSWORD=replace_with_a_separate_long_random_encryption_password
AWS_ACCESS_KEY_ID=replace_with_scoped_backup_access_key
AWS_SECRET_ACCESS_KEY=replace_with_scoped_backup_secret_key
